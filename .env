# -------------------------------------------------------
# 공통 기본값 (.env.local > .env 순으로 우선순위 적용)
# 로컬 환경에서 오버라이드가 필요하면 .env.local 을 수정
# -------------------------------------------------------

# 백엔드 API 서버 주소 (Vite dev proxy 및 Docker nginx proxy 공통 사용)
BACKEND_URL=http://210.217.178.211:8000

# shared-shell.iife.js 경로
# - 로컬/개발: /js/shared-shell.iife.js (public/js/ 에 파일 복사 필요)
# - 운영: https://zerocarbon-planning.kr/shared-shell.iife.js
VITE_SHELL_URL=/js/shared-shell.iife.js

# 정적 리소스(CSS/JS/이미지) 기본 URL
# - 로컬/개발: 비워두면 public/ 디렉토리를 직접 참조
# - 운영: https://zerocarbon-planning.kr
VITE_STATIC_URL=
